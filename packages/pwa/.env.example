# Build-time settings of the web app (copy to .env or .env.local; all optional).

# The edition is not set here: it is the AEGIS_EDITION environment variable of the build command (vite.config.ts).

# A default server baked into your own build (services/serverChoice.ts). Without it the community app asks for the
# server on first run. The broker URL, STUN servers and links normally come from the server's
# /api/chat/server-config; set them here only to skip that first question.
# VITE_DEFAULT_API_URL=https://chat-api.example.com
# VITE_DEFAULT_MQTT_URL=wss://chat-mqtt.example.com/mqtt
# VITE_DEFAULT_STUN_URLS=stun:stun.example.com:3478
# VITE_DEFAULT_SERVER_NAME=Example chat
# VITE_DEFAULT_PRIVACY_URL=https://example.com/privacy
# VITE_DEFAULT_TERMS_URL=https://example.com/terms
# VITE_DEFAULT_SUPPORT_URL=https://example.com/support

# White-label fields of config/environment.default.ts (not used to connect)
# VITE_API_URL=https://chat-api.example.com
# VITE_MQTT_URL=wss://chat-mqtt.example.com/mqtt
# VITE_TURN_URL=turn:turn.example.com:3478

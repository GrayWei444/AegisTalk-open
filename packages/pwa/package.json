{
  "name": "aegistalk-chat-pwa",
  "version": "0.1.0",
  "description": "AegisTalk Chat (community edition) - end-to-end encrypted chat, groups and calls",
  "private": true,
  "type": "module",
  "scripts": {
    "prep:chat": "npm run ensure:crypto && node scripts/copy-sqlite-wasm.mjs",
    "dev": "npm run prep:chat && AEGIS_EDITION=chat vite",
    "build": "npm run prep:chat && tsc -p tsconfig.chat.json && AEGIS_EDITION=chat vite build",
    "build:debug": "npm run prep:chat && tsc -p tsconfig.chat.json && AEGIS_EDITION=chat vite build --mode debug",
    "preview": "vite preview",
    "lint": "eslint src/",
    "type-check": "tsc -p tsconfig.chat.json --noEmit",
    "cap:sync": "npx cap sync",
    "cap:copy": "npx cap copy",
    "cap:update": "npx cap update",
    "android": "npm run build && AEGIS_EDITION=chat npx cap sync android && npx cap open android",
    "android:build": "npm run build && AEGIS_EDITION=chat npx cap sync android",
    "android:run": "npx cap run android",
    "ios": "npm run build && npx cap sync ios && npx cap open ios",
    "ios:build": "npm run build && npx cap sync ios",
    "ios:run": "npx cap run ios",
    "build:crypto": "rm -f src/wasm/pkg/.crypto-core-source.json && node scripts/ensure-crypto-wasm.mjs",
    "ensure:crypto": "node scripts/ensure-crypto-wasm.mjs",
    "test": "node ../../scripts/review/run-all.mjs",
    "sim": "bash ../../scripts/sim/local-run.sh"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^8.0.0",
    "@capacitor/android": "^8.0.1",
    "@capacitor/app": "^8.0.0",
    "@capacitor/browser": "^8.0.0",
    "@capacitor/camera": "^8.0.0",
    "@capacitor/cli": "^7.4.5",
    "@capacitor/core": "^8.0.1",
    "@capacitor/device": "^8.0.0",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/ios": "^8.0.1",
    "@capacitor/keyboard": "^8.0.0",
    "@capacitor/local-notifications": "^8.0.0",
    "@capacitor/network": "^8.0.1",
    "@capacitor/push-notifications": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "@capawesome-team/capacitor-file-opener": "^8.0.1",
    "capacitor-native-biometric": "^4.2.2",
    "hash-wasm": "^4.12.0",
    "html5-qrcode": "^2.3.8",
    "idb": "^7.1.0",
    "jeep-sqlite": "^2.8.0",
    "jsqr": "^1.4.0",
    "mqtt": "^5.3.0",
    "pdfjs-dist": "^5.4.530",
    "qrcode": "^1.5.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sql.js": "1.11.0",
    "zustand": "^4.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.29",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^8.55.0",
    "@typescript-eslint/parser": "^8.55.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "postcss": "^8.4.0",
    "puppeteer": "^24.35.0",
    "tailwindcss": "^3.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vite-plugin-pwa": "^0.17.0",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.5.0",
    "workbox-precaching": "^7.4.0",
    "workbox-routing": "^7.4.0",
    "workbox-strategies": "^7.4.0",
    "workbox-window": "^7.0.0"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not op_mini all"
  ]
}

# AegisTalk chat server (api/chat_app.py). Copy to api/.env and fill in.
# The server refuses to start when a required value is missing or unsafe; the error lists every problem.
# Generate secrets with:  openssl rand -hex 32   (each one different; at least 32 characters)

# ---- Required ----------------------------------------------------------------
# Signs MQTT passwords (HS256 JWT). The EMQX JWT authenticator must use the SAME value
# (docker-compose.example.yml passes it to EMQX as EMQX_AUTHENTICATION__1__SECRET).
# Leave it empty here when you use docker-compose.example.yml: it reads it from the .env next to that file.
AEGIS_MQTT_JWT_SECRET=
# SQLite database (created on first start). The folder must be writable.
AEGIS_DB_PATH=/data/chat.db
# Optional: the group log's own SQLite file (default: group_log.db next to AEGIS_DB_PATH).
AEGIS_GROUP_LOG_DB_PATH=
# Broker URL the apps use (handed out by GET /api/chat/server-config). wss:// only; ws:// is accepted for
# localhost during development.
CHAT_PUBLIC_MQTT_URL=wss://mqtt.example.com/mqtt
# Browser origins allowed to call the API (CORS), comma-separated: the web app's origin plus the app shells
# (https://localhost = Android, capacitor://localhost = iOS). No paths, no wildcards; http:// only for localhost.
CHAT_APP_ORIGINS=https://chat.example.com,https://localhost,capacitor://localhost

# ---- Reverse proxy (required: say what is in front of the API) ----------------
# Address(es) of your TLS reverse proxy as seen by the API, comma-separated IPs or CIDRs, e.g.
#   127.0.0.1          Caddy on the same host, API started with uvicorn on 127.0.0.1
#   172.30.0.1         docker-compose.example.yml (the compose network's gateway: the host's Caddy reaches the
#                      API container through it)
# or "none" when clients connect to the API directly (then X-Forwarded-For is always ignored).
CHAT_TRUSTED_PROXIES=172.30.0.1
# Secret the proxy adds to every request as the X-Aegis-Internal header (Caddy: header_up X-Aegis-Internal ...).
# Required unless CHAT_TRUSTED_PROXIES=none. Only requests from a trusted address that carry this token count as
# "through the proxy": only their X-Forwarded-For is used for per-IP rate limits, and only they may fetch MQTT tokens.
CHAT_PROXY_TOKEN=

# ---- Accounts (keys-only: an account is an identity key) -----------------------
# open | invite | closed. invite (default): new accounts need an invite code:
#   cd api && AEGIS_DB_PATH=... python -m chat.invites create --uses 5 --days 7
#   docker compose -f docker-compose.example.yml exec -u 10001 api python -m chat.invites create --uses 5
CHAT_REGISTRATION=invite
# New-account limits (stored in the database; existing accounts are not affected). Defaults shown.
CHAT_REGISTER_PER_IP_HOUR=3
CHAT_REGISTER_PER_IP_DAY=10
CHAT_REGISTER_PER_HOUR=60
CHAT_REGISTER_PER_DAY=500

# ---- MQTT ------------------------------------------------------------------------
# Where the API itself connects to publish "device replaced" notices (plain MQTT, internal network only).
AEGIS_MQTT_HOST=emqx
AEGIS_MQTT_PORT=1883
# Format of the token's acl claim: rules (EMQX >= 5.7; retain allowed only on the owner's presence topic)
# or legacy ({pub, sub, all}; EMQX 5.3+, cannot restrict retain). Use rules with the pinned EMQX 5.8.9.
CHAT_MQTT_ACL_FORMAT=rules
# How many different group / presence topics one account may obtain in tokens per 24 hours (limits topic
# guessing; an honest phone needs a few hundred at most). Minimum 200.
CHAT_TOKEN_TOPICS_PER_DAY=2000

# ---- Push (optional; both off by default) ----------------------------------------
# Web Push (browsers / the PWA). Generate a key pair with:  cd api && python -m chat.vapid
# Both keys or neither. Needs: pip install -r requirements-webpush.txt
CHAT_VAPID_PUBLIC_KEY=
CHAT_VAPID_PRIVATE_KEY=
# Contact for push services (required with VAPID): mailto:you@example.com or https://example.com
CHAT_VAPID_SUBJECT=
# Push services the server will deliver to (host suffixes). Default: FCM (Chrome, Edge, Android browsers),
# Mozilla (Firefox), Apple (Safari), Microsoft WNS. Anything else is refused at registration.
CHAT_WEBPUSH_HOSTS=
# Firebase Cloud Messaging for native apps built with your own Firebase project: path to the service account
# JSON. Needs: pip install -r requirements-fcm.txt
CHAT_FCM_CREDENTIALS=

# ---- Shown to apps in GET /api/chat/server-config (optional) --------------------
# Comma-separated stun:/stuns: URLs. Empty = apps use their built-in STUN servers.
CHAT_STUN_URLS=
CHAT_SERVER_NAME=
CHAT_PRIVACY_URL=
CHAT_TERMS_URL=
CHAT_SUPPORT_URL=

# ---- Only for `python chat_app.py` (uvicorn command line otherwise) -------------
CHAT_BIND_HOST=127.0.0.1
CHAT_BIND_PORT=8000
